# Database
DB_ROOT_PASSWORD=rootsecret
DB_NAME=parhub
DB_USER=parhub
DB_PASSWORD=parhub123

# Telegram bot token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Admin panel token — change before deploy
ADMIN_TOKEN=change_me_in_production

# МойСклад (https://app.moysklad.ru → Настройки → Токены)
MOYSKLAD_TOKEN=your_moysklad_token_here

# Интервал фоновой синхронизации в минутах (запасной крон, по умолчанию раз в сутки)
SYNC_INTERVAL_MINUTES=1440

# Секрет для вебхука МойСклад — придумай любую строку
WEBHOOK_SECRET=change_me_webhook_secret

# Ключ для экспортного API (GET /api/export/*) — придумай любую строку
EXPORT_API_KEY=change_me_export_key

# Ports
APP_PORT=80
PHPMYADMIN_PORT=8080
