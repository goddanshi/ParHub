PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parhub
DB_USER=parhub
DB_PASSWORD=parhub123

# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Обязательная подписка на канал (оставь пустым чтобы отключить)
REQUIRED_CHANNEL=@parhubopt

# Admin
ADMIN_TOKEN=admin123

# МойСклад (https://app.moysklad.ru → Настройки → Токены)
MOYSKLAD_TOKEN=your_moysklad_token_here

# Интервал синхронизации в минутах (по умолчанию 30)
SYNC_INTERVAL_MINUTES=30
